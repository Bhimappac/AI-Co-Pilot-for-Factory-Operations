# ==============================================================================
# OpsPilot Environment Configuration Example
# Copy this file to .env.local and fill in your API keys / database credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Chat Provider Configuration
# Supported CHAT_PROVIDER options: "anthropic" | "google" | "openai" | "ollama"
# ------------------------------------------------------------------------------
CHAT_PROVIDER="anthropic"
CHAT_MODEL="claude-haiku-5-5"

# Required for CHAT_PROVIDER="anthropic"
ANTHROPIC_API_KEY="sk-ant-..."

# Required for CHAT_PROVIDER="openai"
OPENAI_API_KEY="sk-..."

# Required for CHAT_PROVIDER="google"
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy..."

# Optional for CHAT_PROVIDER="ollama" (default: http://localhost:11434/api)
OLLAMA_BASE_URL="http://localhost:11434/api"

# ------------------------------------------------------------------------------
# 2. Embedding Provider Configuration
# Supported EMBEDDING_PROVIDER options: "google" | "voyage" | "openai" | "ollama"
# (NOTE: Anthropic does NOT offer an embedding model and cannot be used)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER="google"
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIM="768"

# Required if EMBEDDING_PROVIDER="voyage"
VOYAGE_API_KEY="pa-..."

# Cosine Similarity Threshold for procedure retrieval (0.0 to 1.0; 0.4 recommended)
SIMILARITY_THRESHOLD="0.4"

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database with pgvector (Neon, Supabase, or local Docker)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/opspilot"
